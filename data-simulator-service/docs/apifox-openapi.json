            "pattern": "^(?:[0-9a-fA-F]{2})*$",
            "default": "1234"
          },
          "customData": {
            "type": "string",
            "description": "自定义数据十六进制内容，字符数必须等于customDataLength乘2",
            "pattern": "^(?:[0-9a-fA-F]{2})*$",
            "default": "0102030405"
          },
          "ver": {
            "type": "string",
            "description": "版本",
            "pattern": "^[0-9a-fA-F]{2}$",
            "default": "80"
          },
          "mid": {
            "type": "string",
            "description": "任务标志",
            "pattern": "^[0-9a-fA-F]{4}$",
            "default": "0001"
          },
          "sid": {
            "type": "string",
            "description": "信源地址",
            "pattern": "^[0-9a-fA-F]{8}$",
            "default": "00000001"
          },
          "did": {
            "type": "string",
            "description": "信宿地址",
            "pattern": "^[0-9a-fA-F]{8}$",
