          },
          "flag": {
            "type": "string",
            "description": "处理标志",
            "pattern": "^[0-9a-fA-F]{2}$",
            "default": "00"
          },
          "inputFrameLength": {
            "minimum": 1,
            "description": "每次读取的输入帧长度",
            "maximum": 65475,
            "type": "integer",
            "default": 512
          },
          "transportHeaderLength": {
            "minimum": 0,
            "description": "传输头字节长度，零时内容为空字符串",
            "maximum": 65475,
            "type": "integer",
            "default": 2
          },
          "telemetryHeaderLength": {
            "minimum": 0,
            "description": "原帧开头移到末尾的长度，不能超过输入帧长度",
            "maximum": 65475,
            "type": "integer",
            "default": 4
          },
          "customDataLength": {
            "minimum": 0,
            "description": "自定义数据字节长度，零时内容为空字符串",
            "maximum": 65475,
            "type": "integer",
            "default": 5
          },
          "sourceId": {
            "description": "所属模拟源编号，仅响应使用",
            "readOnly": true,
            "type": "integer",
            "format": "int64"
          }
        },
        "description": "仅PDXP使用。所有长度按实例配置，输入帧长度加传输头长度加32加自定义数据长度不得超过65507；FEP必须省略此对象。"
      },
      "SaveRequest": {
