{
  "openapi": "3.0.3",
  "info": {
    "title": "独立模拟源管理服务",
    "version": "1.0.0",
    "description": "支持PDXP/UDP和FEP/TCP，多模拟源独立并发。默认端口8085。发送端不自动启停接收服务。"
  },
  "servers": [
    {
      "url": "http://127.0.0.1:8085",
      "description": "本地独立服务"
    }
  ],
  "paths": {
    "/simulator/sources": {
      "get": {
        "summary": "分页查询模拟源",
        "parameters": [
          {
            "name": "pageNum",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 1,
              "minimum": 1
            },
            "description": "页码"
          },
          {
            "name": "pageSize",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 20,
              "minimum": 1,
              "maximum": 100
            },
            "description": "每页数量"
          },
          {
            "name": "name",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "名称包含查询"
          },
          {
            "name": "status",
            "in": "query",
            "schema": {
              "type": "integer",
              "enum": [
                0,
                1,
                2,
                3,
                4,
                5,
                6
              ]
            },
            "description": "0未启动1启动中2运行中3停止中4已停止5已完成6异常"
          }
        ],
        "responses": {
          "200": {
            "description": "操作成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "integer",
                      "description": "结果码",
                      "example": 200
                    },
                    "message": {
                      "type": "string",
                      "description": "结果说明",
                      "example": "操作成功"
                    },
                    "data": {
                      "type": "object",
                      "properties": {
                        "pageNum": {
                          "type": "integer",
                          "description": "页码"
                        },
                        "pageSize": {
                          "type": "integer",
                          "description": "每页数量"
                        },
                        "total": {
                          "type": "integer",
                          "description": "总数",
                          "format": "int64"
                        },
                        "records": {
                          "type": "array",
                          "items": {
                            "$ref": "#/components/schemas/Source"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "请求校验失败",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "integer",
                      "description": "结果码",
                      "example": 400
                    },
                    "message": {
                      "type": "string",
                      "description": "中文错误说明"
                    }
                  }
                }
              }
            }
          },
          "409": {
            "description": "名称重复、重复启动或运行中编辑等状态冲突",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "integer",
                      "description": "结果码",
                      "example": 409
                    },
                    "message": {
                      "type": "string",
                      "description": "中文错误说明"
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "服务或数据库异常",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "integer",
                      "description": "结果码",
                      "example": 500
                    },
                    "message": {
                      "type": "string",
                      "description": "中文错误说明"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
