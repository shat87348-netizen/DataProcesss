<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.dataprocess.mapper.IoTDBRetentionMapper">
    <!-- IoTDB会话不支持占位符，截止时间由强类型正数毫秒值提供；路径固定。 -->
    <delete id="deleteBefore">
        delete from root.db.** where time &lt; ${beforeTime}
    </delete>
</mapper>
